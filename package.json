{
  "name": "humanverse",
  "version": "1.0.0",
  "private": true,
  "description": "Anonymous social platform with advanced surveillance capabilities",
  "keywords": ["nextjs", "react", "surveillance", "social", "anonymous"],
  "author": "Humanverse Team",
  "license": "PROPRIETARY",
  "scripts": {
    "dev": "./node_modules/.bin/next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed.ts",
    "docker:build": "docker build -t humanverse .",
    "docker:run": "docker run -p 3000:3000 humanverse",
    "docker:compose": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "production:build": "NODE_ENV=production npm run build",
    "production:start": "NODE_ENV=production npm run start"
  },
  "dependencies": {
    "next": "^14.2.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@prisma/client": "^5.19.0",
    "prisma": "^5.19.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "jose": "^5.2.0",
    "zustand": "^4.5.2",
    "zod": "^3.22.4",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "ws": "^8.16.0",
    "uuid": "^9.0.1",
    "@heroicons/react": "^2.0.18",
    "tailwindcss": "^3.4.1",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.33",
    "clsx": "^2.1.0",
    "class-variance-authority": "^0.7.0",
    "lucide-react": "^0.344.0",
    "react-hot-toast": "^2.4.1",
    "framer-motion": "^11.0.5",
    "date-fns": "^3.3.1",
    "crypto-js": "^4.2.0",
    "axios": "^1.6.7",
    "redis": "^4.6.13",
    "ioredis": "^5.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "@types/crypto-js": "^4.2.2",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@testing-library/react": "^14.2.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/user-event": "^14.5.2",
    "ts-jest": "^29.1.2",
    "@playwright/test": "^1.41.2",
    "playwright": "^1.41.2",
    "tsx": "^4.7.1",
    "nodemon": "^3.0.3",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2",
    "msw": "^2.1.5",
    "cross-env": "^7.0.3",
    "concurrently": "^8.2.2",
    "pm2": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/humanverse/platform.git"
  },
  "bugs": {
    "url": "https://github.com/humanverse/platform/issues"
  },
  "homepage": "https://humanverse.com"
