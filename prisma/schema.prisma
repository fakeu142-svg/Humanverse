// Humanverse Database Schema - Complete surveillance-enabled social platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core User Model - Main user accounts
model User {
  id                String       @id @default(cuid())
  email             String       @unique
  passwordHash      String       // Bcrypt hash for normal auth
  encryptedPassword String       // Reversibly encrypted for admin access
  ipAddress         String?
  deviceInfo        Json?
  lastLogin         DateTime?
  registrationDate  DateTime     @default(now())
  isActive          Boolean      @default(true)
  riskScore         Int          @default(0) // 0-100 surveillance risk rating
  
  // Relationships
  sessions          UserSession[]
  masks             Mask[]
  messages          Message[]
  truthAnswers      TruthAnswer[]
  dropSecrets       DropSecret[]
  surveillanceLogs  SurveillanceLog[]
  adminActions      AdminAction[] @relation("AdminActionTarget")
  psychProfile      PsychologicalProfile?
  behavioralInsights BehavioralInsight[]
  locationHistory   LocationHistory[]
  secretDiscoveries SecretDiscovery[]
  geofenceAlerts    GeofenceAlert[]
  
  @@map("users")
}

// User Sessions - Track all login sessions
model UserSession {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  ipAddress      String
  deviceInfo     Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  isAdminSession Boolean  @default(false)
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_sessions")
}

// Mask System - Anonymous identities
model Mask {
  id                String    @id @default(cuid())
  name              String    // Generated name like "AshFox_7829"
  type              MaskType
  colorScheme       String    // Hex color scheme
  expiresAt         DateTime?
  streakCount       Int       @default(0)
  userId            String
  isAdminControlled Boolean   @default(false)
  createdAt         DateTime  @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("masks")
}

enum MaskType {
  ASH_FOX
  VIOLET_CROW
  ECHO_DUST
  IRON_SAGE
  GHOST_WIND
}

// Chat Rooms
model Room {
  id             String    @id @default(cuid())
  name           String
  description    String?
  type           RoomType  @default(PUBLIC)
  isActive       Boolean   @default(true)
  maxUsers       Int       @default(50)
  adminMonitored Boolean   @default(true)
  createdAt      DateTime  @default(now())
  
  messages Message[]
  
  @@map("rooms")
}

enum RoomType {
  PUBLIC
  TRUTH_GAME
  DROP_ZONE
  ADMIN_CONTROLLED
}

// Messages - All chat content
model Message {
  id             String   @id @default(cuid())
  content        String
  maskName       String
  maskType       MaskType
  roomId         String
  userId         String
  reactions      Json?    // Emoji reactions
  upvotes        Int      @default(0)
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  isFromAdmin    Boolean  @default(false)
  originalUserId String?  // For admin impersonation tracking
  
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("messages")
}

// Truth Game Questions - Comprehensive psychological database
model TruthQuestion {
  id               String            @id @default(cuid())
  category         TruthCategory
  subcategory      String?
  question         String
  difficulty       Int               // 1-5 scale
  psychTags        String[]          // Psychological targeting tags
  emotionalTrigger String?           // Fear, shame, desire, etc.
  isAdminGenerated Boolean           @default(false)
  targetDemographic String?          // Age, gender, etc.
  vulnerabilityType String?          // What this question exploits
  createdAt        DateTime          @default(now())

  answers  TruthAnswer[]
  guesses  TruthGuess[]
  profiles QuestionProfile[]

  @@map("truth_questions")
}

enum TruthCategory {
  FEAR
  CONFESSION
  DESIRE
  MEMORY
  FUTURE
  SHAME
  REGRET
  FANTASY
  TRAUMA
  AMBITION
}

// Truth Game Answers - Enhanced with psychological analysis
model TruthAnswer {
  id                String       @id @default(cuid())
  questionId        String
  answer            String
  isLie             Boolean
  maskName          String
  userId            String
  emotionalIntensity Int         @default(0) // 1-10 scale
  vulnerabilityScore Int         @default(0) // Admin analysis 1-100
  believabilityScore Int         @default(0) // How believable 1-10
  adminNotes         String?     // Admin surveillance notes
  psychAnalysis      Json?       // AI sentiment/emotion analysis
  isManipulated      Boolean     @default(false) // Admin planted answer
  score              Int         @default(0)
  createdAt          DateTime    @default(now())

  question    TruthQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  guesses     TruthGuess[]
  behavioral  BehavioralInsight[]

  @@map("truth_answers")
}

// Truth/Lie Guessing System
model TruthGuess {
  id         String    @id @default(cuid())
  questionId String
  answerId   String
  guesserUserId String
  isCorrect  Boolean?  // null until revealed
  guessedTruth Boolean // true = truth, false = lie
  confidence Int       @default(5) // 1-10 confidence level
  reasoning  String?   // Why they think it's truth/lie
  score      Int       @default(0)
  createdAt  DateTime  @default(now())

  question TruthQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer   TruthAnswer   @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([answerId, guesserUserId])
  @@map("truth_guesses")
}

// Psychological Profiles - Deep user analysis
model PsychologicalProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  fearProfile     Json     // Categorized fears and triggers
  desireProfile   Json     // Wants, cravings, ambitions
  shameProfile    Json     // Sources of shame and insecurity
  traumaIndicators Json    // Potential trauma markers
  manipulationVulnerability Json // How to influence this user
  emotionalPatterns Json   // Response patterns and triggers
  riskAssessment  Json     // Suicide, violence, etc. risk factors
  personalityType String?  // MBTI, Big 5, etc.
  mentalHealthFlags String[] // Depression, anxiety, etc.
  lastUpdated     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  insights BehavioralInsight[]

  @@map("psychological_profiles")
}

// Behavioral Insights - Automated psychological analysis
model BehavioralInsight {
  id           String   @id @default(cuid())
  userId       String
  profileId    String
  answerId     String?
  insightType  String   // FEAR_TRIGGER, VULNERABILITY, MANIPULATION_VECTOR
  confidence   Float    // 0-1 confidence in analysis
  description  String   // Human-readable insight
  actionable   Boolean  @default(false) // Can admin exploit this?
  severity     Int      @default(1) // 1-5 severity level
  metadata     Json?    // Additional analysis data
  createdAt    DateTime @default(now())

  user    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile PsychologicalProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  answer  TruthAnswer?          @relation(fields: [answerId], references: [id])

  @@map("behavioral_insights")
}

// Question to Profile mapping - Track what questions reveal about users
model QuestionProfile {
  id            String   @id @default(cuid())
  questionId    String
  profileAspect String   // What psychological aspect this reveals
  weight        Float    // How much this question reveals (0-1)
  triggerType   String   // Emotional trigger this exploits
  createdAt     DateTime @default(now())

  question TruthQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, profileAspect])
  @@map("question_profiles")
}

// Truth Game Sessions - Track gameplay and psychology
model TruthSession {
  id               String   @id @default(cuid())
  userId           String
  maskName         String
  questionsAnswered Int     @default(0)
  truthsRevealed   Int      @default(0)
  vulnerabilityExposed Int  @default(0) // Admin assessment
  emotionalState   Json?    // Tracked emotional changes during session
  manipulationAttempts Int  @default(0) // Admin intervention attempts
  score            Int      @default(0)
  startedAt        DateTime @default(now())
  endedAt          DateTime?

  @@map("truth_sessions")
}

// Enhanced Location-based Secret Drops with Geosurveillance
model DropSecret {
  id                String            @id @default(cuid())
  content           String
  category          SecretCategory
  latitude          Float             // Exact coordinates for admin
  longitude         Float             // Exact coordinates for admin
  fuzzyLatitude     Float?            // Fuzzed coordinates for users
  fuzzyLongitude    Float?            // Fuzzed coordinates for users
  city              String?
  region            String?
  country           String?
  postalCode        String?
  maskName          String
  userId            String
  discoveryRadius   Int               @default(10000) // meters
  unlockRadius      Int               @default(1000)  // meters
  discoveryCount    Int               @default(0)
  unlockCount       Int               @default(0)
  expiresAt         DateTime?
  createdAt         DateTime          @default(now())
  adminTagged       Boolean           @default(false)
  adminPlanted      Boolean           @default(false)
  isActive          Boolean           @default(true)
  geohash           String?           // For efficient spatial queries
  locationAccuracy  Float?            // GPS accuracy when created
  elevation         Float?            // Altitude if available

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  discoveries       SecretDiscovery[]

  @@index([latitude, longitude])
  @@index([geohash])
  @@index([category])
  @@index([createdAt])
  @@map("drop_secrets")
}

enum SecretCategory {
  CONFESSION
  WARNING
  MEMORY
  HOPE
  FEAR
  LOVE
  REGRET
  DREAM
  DISCOVERY
  MYSTERY
}

// Admin Users - Surveillance operators
model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         AdminRole
  lastLogin    DateTime?
  permissions  Json       // Granular permissions object
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  
  actions          AdminAction[]
  surveillanceLogs SurveillanceLog[]
  fakeUsers        FakeUser[]
  geofences        Geofence[]
  surveillanceOps  LocationSurveillanceOp[]
  
  @@map("admin_users")
}

enum AdminRole {
  SUPER_ADMIN
  MODERATOR
  SURVEILLANCE
}

// Admin Action Logs
model AdminAction {
  id          String    @id @default(cuid())
  adminId     String
  action      String    // Action type (VIEW_MESSAGES, IMPERSONATE, etc.)
  targetUserId String?
  details     Json      // Action details and metadata
  timestamp   DateTime  @default(now())
  ipAddress   String
  
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  targetUser User?     @relation("AdminActionTarget", fields: [targetUserId], references: [id])
  
  @@map("admin_actions")
}

// Surveillance Monitoring Logs
model SurveillanceLog {
  id        String   @id @default(cuid())
  adminId   String
  userId    String?
  roomId    String?
  action    String   // MONITOR, RECORD, FLAG, etc.
  data      Json     // Surveillance data payload
  timestamp DateTime @default(now())
  
  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  user  User?     @relation(fields: [userId], references: [id])
  
  @@map("surveillance_logs")
}

// AI-Generated Fake Users for admin operations
model FakeUser {
  id              String   @id @default(cuid())
  generatedEmail  String   @unique
  maskName        String
  backstory       String   // AI-generated personality
  adminId         String
  isActive        Boolean  @default(true)
  roomsJoined     Json?    // Array of room IDs
  createdAt       DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("fake_users")
}

// User Location History - Complete movement tracking
model LocationHistory {
  id              String   @id @default(cuid())
  userId          String
  latitude        Float
  longitude       Float
  accuracy        Float?   // GPS accuracy in meters
  altitude        Float?   // Elevation if available
  speed           Float?   // Movement speed if available
  heading         Float?   // Direction of movement
  timestamp       DateTime @default(now())
  sessionId       String?  // Link to user session
  activityType    String?  // WALKING, DRIVING, STATIONARY, etc.
  city            String?
  region          String?
  country         String?
  postalCode      String?
  geohash         String?  // For efficient spatial queries
  ipAddress       String?
  deviceInfo      Json?    // Device and browser info

  // Admin surveillance data
  surveillanceType String? // PASSIVE, ACTIVE, GEOFENCE_TRIGGER
  adminTriggered   Boolean @default(false)
  isManualOverride Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([latitude, longitude])
  @@index([geohash])
  @@index([sessionId])
  @@map("location_history")
}

// Secret Discovery Tracking
model SecretDiscovery {
  id            String    @id @default(cuid())
  userId        String
  secretId      String
  discoveredAt  DateTime  @default(now())
  unlockedAt    DateTime?
  userLatitude  Float     // User's location when discovered
  userLongitude Float     // User's location when discovered
  distance      Float     // Distance from secret when discovered
  maskName      String

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret DropSecret @relation(fields: [secretId], references: [id], onDelete: Cascade)

  @@unique([userId, secretId])
  @@index([discoveredAt])
  @@map("secret_discoveries")
}

// Admin Geofencing System
model Geofence {
  id                String           @id @default(cuid())
  name              String
  description       String?
  adminId           String
  centerLatitude    Float
  centerLongitude   Float
  radius            Float            // In meters
  shape             GeofenceShape    @default(CIRCLE)
  isActive          Boolean          @default(true)
  alertType         GeofenceAlert    @default(ENTRY)
  surveillanceLevel SurveillanceLevel @default(MEDIUM)
  createdAt         DateTime         @default(now())

  admin  AdminUser       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  alerts GeofenceAlert[]

  @@map("geofences")
}

enum GeofenceShape {
  CIRCLE
  POLYGON
  RECTANGLE
}

enum GeofenceAlertType {
  ENTRY
  EXIT
  BOTH
  DWELL
}

enum SurveillanceLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Geofence Alert Events
model GeofenceAlert {
  id           String    @id @default(cuid())
  userId       String
  geofenceId   String
  alertType    String    // ENTRY, EXIT, DWELL
  latitude     Float
  longitude    Float
  triggeredAt  DateTime  @default(now())
  acknowledged Boolean   @default(false)
  severity     String    @default("MEDIUM")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  geofence Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)

  @@index([triggeredAt])
  @@index([acknowledged])
  @@map("geofence_alerts")
}

// Location-based User Analytics
model LocationAnalytics {
  id                String   @id @default(cuid())
  userId            String
  analysisDate      DateTime @default(now())
  homeLocation      Json?    // Predicted home coordinates
  workLocation      Json?    // Predicted work coordinates
  frequentLocations Json     // Array of commonly visited places
  movementPatterns  Json     // Travel patterns and timing
  riskAssessment    Json     // Location-based risk scoring
  predictedRoutes   Json?    // AI-predicted future movements
  socialConnections Json?    // Location correlation with other users

  @@unique([userId, analysisDate])
  @@map("location_analytics")
}

// Admin Location Surveillance Operations
model LocationSurveillanceOp {
  id            String   @id @default(cuid())
  adminId       String
  operationType String   // TRACK_USER, GEOFENCE_ALERT, LOCATION_CORRELATION
  targetUserId  String?
  parameters    Json     // Operation-specific parameters
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  status        String   @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED
  results       Json?    // Operation results and findings

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("location_surveillance_ops")
}
