# Production Environment Variables
# Copy this file to .env.local and update with your production values

# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://humanverse.com
NEXT_PUBLIC_API_URL=https://api.humanverse.com

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/humanverse_prod
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=humanverse_prod

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# Authentication & Security
JWT_SECRET=your_super_secure_jwt_secret_key_at_least_32_characters
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_key_at_least_32_characters
ENCRYPTION_KEY=your_32_character_encryption_key_here
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_at_least_32_characters

# Admin Surveillance
SURVEILLANCE_ENCRYPTION_KEY=your_surveillance_encryption_key_32_chars
ADMIN_SESSION_SECRET=your_admin_session_secret_key_32_chars
FAKE_USER_API_KEY=your_fake_user_generation_api_key

# Email Service (for notifications)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_email@humanverse.com
SMTP_PASSWORD=your_email_password
FROM_EMAIL=noreply@humanverse.com

# File Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=humanverse-storage
AWS_REGION=us-east-1

# Monitoring & Analytics
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
LOGTAIL_TOKEN=your_logtail_token

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket Configuration
WEBSOCKET_PATH=/socket.io
WEBSOCKET_CORS_ORIGIN=https://humanverse.com

# API Keys for External Services
OPENAI_API_KEY=your_openai_api_key_for_psychological_profiling
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Surveillance System
SURVEILLANCE_DB_URL=postgresql://surv_user:surv_pass@surveillance-db:5432/surveillance
THREAT_DETECTION_API_KEY=your_threat_detection_api_key
BEHAVIORAL_ANALYSIS_KEY=your_behavioral_analysis_key

# Content Moderation
CONTENT_MODERATION_API_KEY=your_content_moderation_key
AUTO_MODERATION_THRESHOLD=0.8

# Backup & Recovery
BACKUP_S3_BUCKET=humanverse-backups
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_32_chars
BACKUP_SCHEDULE=0 2 * * *

# SSL & Domain
SSL_CERT_PATH=/etc/ssl/certs/humanverse.crt
SSL_KEY_PATH=/etc/ssl/private/humanverse.key
DOMAIN=humanverse.com

# Performance Monitoring
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
DATADOG_API_KEY=your_datadog_api_key

# Security Scanning
SECURITY_SCAN_API_KEY=your_security_scanning_api_key
VULNERABILITY_DB_URL=https://vuln-db.humanverse.com

# Feature Flags
FEATURE_SURVEILLANCE_ENABLED=true
FEATURE_FAKE_USERS_ENABLED=true
FEATURE_MESSAGE_INTERCEPTION=true
FEATURE_LOCATION_TRACKING=true
FEATURE_PSYCHOLOGICAL_PROFILING=true

# Legal & Compliance
GDPR_COMPLIANCE_MODE=false
DATA_RETENTION_DAYS=2555
SURVEILLANCE_LOG_RETENTION=7300

# Emergency Procedures
EMERGENCY_SHUTDOWN_KEY=your_emergency_shutdown_key
INCIDENT_RESPONSE_WEBHOOK=https://alerts.humanverse.com/incident
ADMIN_ALERT_EMAIL=admin@humanverse.com

# Docker Configuration
DOCKER_REGISTRY=registry.humanverse.com
DOCKER_IMAGE_TAG=latest

# Load Balancer
LOAD_BALANCER_URL=https://lb.humanverse.com
HEALTH_CHECK_PATH=/api/health

# CDN
CDN_URL=https://cdn.humanverse.com
STATIC_ASSETS_URL=https://static.humanverse.com

# Message Queue
RABBITMQ_URL=amqp://username:password@rabbitmq:5672
QUEUE_SURVEILLANCE_EVENTS=surveillance_events
QUEUE_USER_ACTIVITIES=user_activities

# Elasticsearch (for log aggregation)
ELASTICSEARCH_URL=https://elasticsearch.humanverse.com:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elastic_password

# Geolocation Services
GEOLOCATION_API_KEY=your_geolocation_api_key
IP_GEOLOCATION_URL=https://api.ipgeolocation.io

# AI/ML Services
MACHINE_LEARNING_API_URL=https://ml.humanverse.com
PSYCHOLOGICAL_ANALYSIS_URL=https://psycho-analysis.humanverse.com
BEHAVIOR_PREDICTION_URL=https://behavior-prediction.humanverse.com

# Notification Services
PUSH_NOTIFICATION_KEY=your_push_notification_key
SMS_GATEWAY_URL=https://sms.humanverse.com
WEBHOOK_SECRET=your_webhook_secret_key
