# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/humanverse"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-here"
ENCRYPTION_KEY="your-32-character-encryption-key"

# Admin Configuration
ADMIN_MASTER_EMAIL="admin@humanverse.com"
ADMIN_MASTER_PASSWORD="AdminMaster2024!"

# Surveillance Settings
SURVEILLANCE_MODE=true
ADMIN_SESSION_TIMEOUT=3600

# Socket.IO Configuration
SOCKET_SECRET="your-socket-secret-key"

# Email Configuration (Optional)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="noreply@humanverse.com"
SMTP_PASS="your-email-password"

# Development
NODE_ENV="development"
NEXTAUTH_URL="http://localhost:8080"
